# ============================================================================
# 环境变量模板 —— 复制为 .env.local 后填写真实值
#   cp .env.example .env.local
# 注意：.env.local 与所有 .env* 都被 .gitignore 忽略，切勿提交真实密钥。
# ============================================================================

# ===== Neon（Postgres）=====
# 池化连接串（应用运行时用）
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# 直连连接串（drizzle-kit 迁移用；未填时回退 DATABASE_URL）
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"
# Neon 分支名（可选，仅部分脚本/函数读取）
NEON_BRANCH="production"

# ===== Neon Auth（认证；Neon 控制台 → Auth 获取）=====
NEON_AUTH_BASE_URL="https://<auth-endpoint>.neon.tech"
NEON_AUTH_COOKIE_SECRET="<random-32-bytes>"

# ===== Neon Storage（S3 兼容，简历照片）=====
# 控制台创建 bucket 后按控制台给的 endpoint / 密钥填入
NEON_STORAGE_ENDPOINT="https://<project>.neon.tech/..."
NEON_STORAGE_REGION="auto"
NEON_STORAGE_BUCKET="resume-photos"
NEON_STORAGE_ACCESS_KEY="..."
NEON_STORAGE_SECRET_KEY="..."
# bucket 公开读时的前缀；同时用于 PDF 导出时的图片来源白名单（SSRF 防护）
NEON_STORAGE_PUBLIC_URL="https://..."

# ===== Neon Realtime（实时同步，可选）=====
NEON_REALTIME_URL="https://<realtime-endpoint>"
NEON_REALTIME_SECRET="..."
# 浏览器端 WebSocket 地址（公开值，不含 secret）
NEXT_PUBLIC_NEON_REALTIME_URL=""

# ===== Neon 账号注销（服务端删除 Auth 用户，可选；勿加 NEXT_PUBLIC_）=====
NEON_PROJECT_ID=""
NEON_BRANCH_ID=""
NEON_API_KEY=""

# ===== Neon Functions（关键词提取函数，可选）=====
NEON_FUNCTION_HELLO_BASE_URL=""
NEON_FUNCTION_KEYWORDS_BASE_URL=""

# ===== DeepSeek（AI 润色，点数计费）=====
# 可以先留空：未配置时 AI 入口会明确提示「DeepSeek API 尚未配置」，且不会扣点。
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# 本地演示模式：=1 时不调用网络、返回示例改写（仅非生产环境生效）
AI_MOCK="0"

# ===== 支付 =====
# manual = 本机沙箱（直接到账、不扣款）；mbd = 面包多Pay；afdian = 爱发电；alipay / wechat = 官方直连
PAY_PROVIDER="manual"
# 生产环境禁止 manual；如确需在预发使用沙箱，显式置 1
PAY_ALLOW_MANUAL="0"
# 异步回调验签密钥（POST /api/webhooks/payment，HMAC-SHA256）
PAY_WEBHOOK_SECRET="..."
# 面包多Pay（字段以 doc.mbd.pub 为准，接入时填写）
MBD_PAY_MERCHANT_ID=""
MBD_PAY_API_KEY=""
MBD_PAY_NOTIFY_URL=""
# 爱发电（兜底：站外支付后回站内填订单号核销）
AFDIAN_USER_ID=""
AFDIAN_API_TOKEN=""

# ===== 旧版 Lemon Squeezy（已废弃，仅保留兼容；可全部留空）=====
LEMON_SQUEEZY_API_KEY=""
LEMON_SQUEEZY_STORE_ID=""
LEMON_SQUEEZY_VARIANT_ID=""
LEMON_SQUEEZY_WEBHOOK_SECRET=""

# ===== App =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ===== Hero 视觉素材生成（可选，仅 scripts/hero/* 使用；按次计费）=====
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com"
