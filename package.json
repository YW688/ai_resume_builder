{
  "name": "ai-resume-builder",
  "version": "0.1.0",
  "description": "面向中文求职者的 AI 简历编辑器：JD 对齐润色、A4 PDF 导出、投递追踪（Next.js + Neon + DeepSeek）。",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YW688/ai_resume_builder.git"
  },
  "homepage": "https://github.com/YW688/ai_resume_builder#readme",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tunnel": "node scripts/dev/tunnel.mjs",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/db/seed.mjs",
    "db:inspect": "node scripts/db/inspect.mjs",
    "legal:render": "node scripts/legal/render-docs.mjs",
    "functions:deploy": "neon deploy -y --config-dir .neon-config",
    "functions:list": "neon functions list --config-dir .neon-config"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@neon/realtime": "^0.1.2",
    "@neon/realtime-drizzle": "^0.1.0",
    "@neon/realtime-react": "^0.1.1",
    "@neondatabase/auth": "^0.7.0-beta",
    "@neondatabase/auth-ui": "^0.4.0-beta",
    "@neondatabase/serverless": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "openai": "^7.38.0",
    "playwright": "^1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
