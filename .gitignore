# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code 本地密钥/权限（由 scripts/hero/setup-claude.ps1 生成，勿提交）
.claude/settings.local.json

# Neon CLI 本地工具与凭证（不提交）
/.tools/
/.neon-config/
/.npm-cache/
/.npm-tmp/
/.env.neon-cli
.neon

# Windows 沙箱 ACL 修复报告（不提交）
/.acl-reports/
